export XDG_CURRENT_DESKTOP="Openbox"
export DESKTOP_SESSION="openbox"
export XDG_CURRENT=0

killall -q xfce4-power-manager
killall -q xfsettingsd
killall -q xfce4-notifyd
killall -q xfce4-panel


~/.config/polybar/launch.sh &

feh --bg-fill /usr/share/backgrounds/linuxmint-wallpapers/jpanchal_cpu.jpg

if [-z "$DBUS_SESION_BUS_ADDRESS"]; then
    eval $(dbus-launch --sh-syntax --exit-with-session)
fi
dbus-update-activation-environment --all &
